# Slack (see README setup)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Primary model: Qwen through OpenRouter (free tier works). Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# Fallback model on Groq (optional). Key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=

# Optional: comma-separated Slack channel IDs to answer in (empty = all the bot is in)
ALLOWED_CHANNEL_IDS=
# true = in channels only answer when @mentioned (DMs are always answered)
REQUIRE_MENTION=false
