# Slack (see README for how to create the app)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Models. Set the model IDs you want; they are intentionally not hard-coded.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# Optional: comma-separated Slack channel IDs the bot may answer in (empty = all it is in)
ALLOWED_CHANNEL_IDS=
# Optional: in channels, only answer when @mentioned (DMs always answered)
REQUIRE_MENTION=false
